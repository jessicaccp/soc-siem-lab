# Shuffle standalone (T18). Copie para .env e preencha as senhas.
# O compose lê este arquivo para interpolar as portas e os caminhos locais.
TZ=America/Fortaleza

# Portas publicadas no host: UI em 3001, API em 5001.
FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
BACKEND_PORT=5001
BACKEND_HOSTNAME=shuffle-backend
OUTER_HOSTNAME=shuffle-backend
BASE_URL=http://shuffle-backend:5001
SSO_REDIRECT_URL=http://localhost:3001

# Diretórios locais (bind mounts), relativos a este arquivo.
SHUFFLE_APP_HOTLOAD_FOLDER=./shuffle-apps
SHUFFLE_APP_HOTLOAD_LOCATION=./shuffle-apps
SHUFFLE_FILE_LOCATION=./shuffle-files
DB_LOCATION=./shuffle-database

# Usuário administrador criado no primeiro start do backend.
# A apikey precisa ter formato de UUID (o backend recusa menos de 36 caracteres).
SHUFFLE_DEFAULT_USERNAME=admin
SHUFFLE_DEFAULT_PASSWORD=change-me
SHUFFLE_DEFAULT_APIKEY=00000000-0000-0000-0000-000000000000

# Cifra as credenciais dos apps: trocar depois invalida o que já foi salvo.
SHUFFLE_ENCRYPTION_MODIFIER=change-me

# OpenSearch interno do Shuffle, com heap limitado no compose.
SHUFFLE_OPENSEARCH_URL=https://shuffle-opensearch:9200
SHUFFLE_OPENSEARCH_SKIPSSL_VERIFY=true
SHUFFLE_OPENSEARCH_USERNAME=admin
SHUFFLE_OPENSEARCH_PASSWORD=change-me
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me

# Sem Docker Swarm no host: o orborus roda os workers como containers simples,
# em vez de serviços e da rede overlay shuffle_swarm_executions.
SHUFFLE_SWARM_CONFIG=false

# O orborus repassa estas variáveis para os workers; sem proxy no laboratório.
HTTP_PROXY=
HTTPS_PROXY=
SHUFFLE_PASS_WORKER_PROXY=TRUE
SHUFFLE_PASS_APP_PROXY=TRUE
SHUFFLE_INTERNAL_HTTP_PROXY=noproxy
SHUFFLE_INTERNAL_HTTPS_PROXY=noproxy
