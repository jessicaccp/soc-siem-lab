# Variáveis da stack Wazuh
#
# Copie este arquivo para .env no mesmo diretório antes de subir a stack:
#   cp .env.example .env
# O .env não é versionado (credenciais e ajustes locais ficam fora do git).
#
# Os valores abaixo são os padrão da imagem oficial wazuh-docker 4.14.7.
# Trocar antes de expor qualquer porta fora da rede local (atividade T48).

# Senha do usuário admin do indexer, usada pelo manager e pelo dashboard.
# Se trocar, gere o hash correspondente no internal_users.yml ou a autenticação falha.
INDEXER_PASSWORD=SecretPassword

# Senha do usuário da API do Wazuh (wazuh-wui).
API_PASSWORD=MyS3cr37P450r.*-

# Senha do usuário interno do dashboard (kibanaserver).
DASHBOARD_PASSWORD=kibanaserver

# Versão das imagens, fixada também no docker-compose.yml.
WAZUH_IMAGE_VERSION=4.14.7
